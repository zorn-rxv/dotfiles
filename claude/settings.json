{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:hexdocs.pm)",
      "WebFetch(domain:*.hexdocs.pm)",
      "Bash(/Applications/Google Chrome.app/Contents/MacOS/Google Chrome --headless=new --screenshot=*)"
    ],
    "deny": [
      "AskUserQuestion"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/mikezornek/QuestLog"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/hexdocs-subdomain.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "frontend-design@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark"
}
