# To see `mise` and thus Elixir things via Claude shell.
if [ -x /opt/homebrew/bin/mise ]; then
  eval "$(/opt/homebrew/bin/mise activate zsh --shims)"
fi

# libpq is keg-only, so Homebrew does not link psql into its bin.
if [ -d /opt/homebrew/opt/libpq/bin ]; then
  export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
fi

# Opt out of CLI telemetry for every tool that honors the DO_NOT_TRACK
# convention, such as the Render CLI. fish/config.fish sets it for fish.
export DO_NOT_TRACK=1
